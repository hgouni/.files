[Security]
EAP-Method=PEAP
EAP-Identity=anonymous@andrew.cmu.edu
# system trust store
EAP-PEAP-CACert=/etc/ssl/certs/ca-certificates.crt
EAP-PEAP-Phase2-Method=MSCHAPV2
EAP-PEAP-Phase2-Identity={username}@andrew.cmu.edu
EAP-PEAP-Phase2-Password-Hash={generate via: printf '%s' '<password>' | iconv -t utf16le | openssl md4 -provider legacy}
EAP-PEAP-ServerDomainMask=wireless.cmu.edu

[Settings]
Autoconnect=true
